flowchart TB
  coordinator["Ops Coordinator\nLinh / Huy / Mai"]

  subgraph browser["Browser"]
    frontend["React + MUI SPA\nZustand state · Axios client\nNginx :8080"]
  end

  subgraph api["NestJS API"]
    auth["Mock session\nBearer token"]
    vendors["Vendor service\nBusiness rules only"]
    ports["Repository ports\nInjection tokens"]
    adapters["TypeORM adapters\nQueries + transaction"]
    concurrency["Redis lock\n+ version check"]
  end

  subgraph data["Data services"]
    postgres[("PostgreSQL\nusers · stages · vendors\nhistories · app settings")]
    redis[("Redis\nlock:vendor:id")]
  end

  coordinator -->|"Login, view, update"| frontend
  frontend -->|"/api via reverse proxy"| auth
  frontend -->|"Read vendors/history"| vendors
  frontend -->|"PATCH + Bearer token + version"| auth
  auth -->|"Authenticated coordinator"| vendors
  vendors -->|"interface calls"| ports
  ports -->|"NestJS token binding"| adapters
  vendors --> concurrency
  concurrency -->|"short lock"| redis
  adapters -->|"transaction + version + audit"| postgres

  classDef person fill:#fff3e0,stroke:#ef6c00,color:#4e2600;
  classDef app fill:#e3f2fd,stroke:#1565c0,color:#0d2c52;
  classDef port fill:#fff8e1,stroke:#f9a825,color:#4d3a00;
  classDef data fill:#e8f5e9,stroke:#2e7d32,color:#153f1f;
  class coordinator person;
  class frontend,auth,vendors,concurrency app;
  class ports port;
  class adapters,postgres,redis data;
